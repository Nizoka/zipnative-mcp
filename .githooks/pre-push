#!/bin/sh
# zipnative-mcp — opt-in pre-push hook.
#
# Installed with `npm run hooks:install`; removed with `npm run hooks:uninstall`.
# Runs the fast gate profile (typecheck:all, lint, test, server-json, verify:docs)
# before anything leaves the machine. CI runs the full profile afterwards on
# Linux, Windows and macOS, the veraZIP conformance gate included.

if ! npx tsx scripts/gate.ts --fast; then
    echo 'pre-push: the fast gate failed; nothing was pushed.' >&2
    exit 1
fi

exit 0
